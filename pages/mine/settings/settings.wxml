<navigation-bar title="系统设置" color="#111111" background="transparent"></navigation-bar>

<view class="settings-page">
  <view class="setting-section" wx:for="{{sections}}" wx:key="title" wx:for-item="section">
    <view class="section-title">{{section.title}}</view>
    <view class="setting-card">
      <view
        class="setting-row"
        wx:for="{{section.items}}"
        wx:key="key"
        wx:for-item="item"
        data-key="{{item.key}}"
        data-label="{{item.label}}"
        bindtap="handleSettingTap"
        hover-class="tap-active"
        hover-stay-time="80"
      >
        <text>{{item.label}}</text>
        <view class="row-arrow"></view>
      </view>
    </view>
  </view>

  <view class="dialog-mask" wx:if="{{showCancelAccountDialog}}">
    <view class="clear-dialog account-confirm-dialog">
      <view class="dialog-title">注销账号</view>
      <view class="dialog-text">注销后将删除您的全部数据，此操作不可恢复</view>
      <view class="dialog-actions">
        <view class="dialog-button cancel" bindtap="closeCancelAccountDialog">取消</view>
        <view class="dialog-button confirm" bindtap="openCancelAccountSecondDialog">确定</view>
      </view>
    </view>
  </view>

  <view class="dialog-mask" wx:if="{{showCancelAccountSecondDialog}}">
    <view class="clear-dialog account-confirm-dialog">
      <view class="dialog-title">再次确认</view>
      <view class="dialog-text">注销后小程序内历史数据会被永久删除，确定继续吗？</view>
      <view class="dialog-actions">
        <view class="dialog-button cancel" bindtap="closeCancelAccountSecondDialog">取消</view>
        <view class="dialog-button confirm {{cancelingAccount ? 'disabled' : ''}}" bindtap="confirmCancelAccount">确定</view>
      </view>
    </view>
  </view>

  <view class="dialog-mask" wx:if="{{showCancelAccountSuccessDialog}}">
    <view class="clear-dialog">
      <view class="dialog-title">账号已注销</view>
      <view class="dialog-text">账号已成功注销，所有数据已删除。</view>
      <view class="dialog-actions single">
        <view class="dialog-button confirm success-confirm" bindtap="finishCancelAccount">确定</view>
      </view>
    </view>
  </view>

  <view class="dialog-mask" wx:if="{{showClearCacheDialog}}">
    <view class="clear-dialog">
      <view class="dialog-title">清除缓存</view>
      <view class="dialog-text">将清除本地记录、缓存图片，云端记录不会被删除</view>
      <view class="dialog-actions">
        <view class="dialog-button cancel" bindtap="closeClearCacheDialog">取消</view>
        <view class="dialog-button confirm" bindtap="confirmClearCache">确定</view>
      </view>
    </view>
  </view>

  <view class="account-loading-toast" wx:if="{{showCancelAccountToast}}">
    <image class="loading-gift-icon" src="/assets/icons/loading-gift.svg" mode="aspectFit"></image>
    <view>账号正在注销...</view>
  </view>
</view>
