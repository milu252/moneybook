page {
  min-height: 100vh;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.profile-edit-page {
  min-height: 100vh;
  padding: 116rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}

.avatar-section::after {
  border: 0;
}

.avatar-wrap {
  width: 176rpx;
  height: 176rpx;
  position: relative;
}

.avatar-circle {
  width: 176rpx;
  height: 176rpx;
  overflow: hidden;
  border: 2rpx solid #d4c8b8;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
  position: relative;
  box-sizing: border-box;
}

.avatar-image,
.avatar-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-image {
  z-index: 2;
}

.avatar-placeholder {
  z-index: 1;
}

.avatar-camera {
  position: absolute;
  right: 2rpx;
  bottom: 6rpx;
  width: 44rpx;
  height: 44rpx;
  z-index: 5;
}

.form-section {
  width: 600rpx;
  margin-top: 52rpx;
  margin-left: auto;
  margin-right: auto;
}

.field-block {
  margin-bottom: 38rpx;
}

.field-label {
  color: #1f1b18;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  border: 2rpx solid #d4c8b8;
  border-radius: 28rpx;
  color: #111111;
  background: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  box-sizing: border-box;
}

.nickname-input {
  padding: 0 34rpx;
  text-align: center;
}

.save-button {
  width: 520rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin: 120rpx auto 0;
  border: 2rpx solid #d4c8b8;
  border-radius: 46rpx;
  color: #111111;
  background: rgba(255, 255, 255, 0.72);
  font-size: 32rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.save-icon {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  display: block;
}

.tap-active {
  opacity: 0.68;
}
