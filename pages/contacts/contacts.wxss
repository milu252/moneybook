page {
  min-height: 100vh;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.contacts-page {
  height: calc(100vh - 94px);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.contacts-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.contacts-content {
  padding-bottom: 0;
  box-sizing: border-box;
}

.search-wrap {
  padding: 22rpx 22rpx 24rpx;
  position: relative;
  z-index: 5;
  box-sizing: border-box;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #bfc0c2;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.search-svg-icon {
  width: 42rpx;
  height: 42rpx;
  display: block;
  flex: none;
  opacity: 0.72;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 26rpx;
  color: #111111;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: #b0b0b0;
  font-size: 28rpx;
}

.clear-button {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  color: #8a8a8a;
  font-size: 34rpx;
  line-height: 1;
}

.suggestion-panel {
  position: absolute;
  left: 82rpx;
  right: 22rpx;
  top: 108rpx;
  overflow: hidden;
  border: 2rpx solid #e2d8ca;
  border-radius: 18rpx;
  background: #fffdf9;
  box-shadow: 0 12rpx 28rpx rgba(85, 67, 48, 0.12);
  z-index: 20;
}

.suggestion-item {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 1rpx solid #eadfce;
  box-sizing: border-box;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.suggestion-name {
  flex: 1;
  min-width: 0;
  color: #111111;
  font-size: 28rpx;
  font-weight: 400;
}

.suggestion-meta {
  width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: none;
  color: #8a8a8a;
  font-size: 22rpx;
  white-space: nowrap;
}

.suggestion-count {
  width: 104rpx;
  flex: none;
  text-align: right;
}

.contact-list {
  padding: 2rpx 22rpx 0;
  box-sizing: border-box;
}

.group-title {
  height: 48rpx;
  display: flex;
  align-items: center;
  padding: 0 0 0 6rpx;
  color: #8d8780;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.contact-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 24rpx 0 34rpx;
  border: 2rpx solid #eadfce;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 10rpx 22rpx rgba(122, 88, 44, 0.04);
  box-sizing: border-box;
}

.contact-row:last-child {
  margin-bottom: 14rpx;
}

.contacts-empty-guide {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 152rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.contacts-empty-icon {
  width: 82rpx;
  height: 82rpx;
  display: block;
  margin-bottom: 18rpx;
}

.contacts-empty-text {
  color: #9a948d;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.contact-main {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 22rpx;
  padding-left: 8rpx;
}

.contact-name {
  color: #111111;
  font-size: 31rpx;
  font-weight: 400;
}

.contact-count {
  color: #9b9b9b;
  font-size: 24rpx;
  font-weight: 400;
}

.row-arrow {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  position: relative;
  flex: none;
}

.row-arrow::before {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 13rpx;
  width: 18rpx;
  height: 18rpx;
  border-right: 4rpx solid #9b9b9b;
  border-top: 4rpx solid #9b9b9b;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.total-text {
  margin-top: 28rpx;
  color: #9b9b9b;
  font-size: 24rpx;
  font-weight: 400;
  text-align: center;
}

.list-total-text {
  padding-bottom: calc(94px + 36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
