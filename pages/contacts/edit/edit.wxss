page {
  min-height: 100vh;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.contact-edit-page {
  min-height: 100vh;
  padding: 0 38rpx 80rpx;
  position: relative;
  box-sizing: border-box;
}

.top-space {
  height: calc(148rpx + env(safe-area-inset-top));
}

.back-btn {
  position: absolute;
  left: 34rpx;
  top: calc(104rpx + env(safe-area-inset-top));
  width: 48rpx;
  height: 48rpx;
  z-index: 5;
}

.back-btn::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 10rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 6rpx solid #111111;
  border-bottom: 6rpx solid #111111;
  transform: rotate(45deg);
}

.page-title {
  position: absolute;
  left: 150rpx;
  right: 150rpx;
  top: calc(104rpx + env(safe-area-inset-top));
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111111;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.edit-title {
  margin: 30rpx 0 38rpx 28rpx;
  color: #111111;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.info-card {
  padding: 24rpx 28rpx 26rpx;
  border: 2rpx solid #c8c0b8;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
}

.field-label {
  color: #1f1b18;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.name-input {
  width: 100%;
  height: 76rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border: 2rpx solid #c8c0b8;
  border-radius: 20rpx;
  color: #111111;
  background: rgba(255, 255, 255, 0.82);
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9f9a94;
  font-size: 26rpx;
}

.action-row {
  display: flex;
  justify-content: center;
  padding: 0 18rpx;
  margin-top: 32rpx;
  box-sizing: border-box;
}

.save-button {
  width: calc((100% - 64rpx) / 2);
  height: 82rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c8c0b8;
  border-radius: 18rpx;
  color: #1f1b18;
  background: rgba(255, 255, 255, 0.9);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 82rpx;
  box-sizing: border-box;
}

.delete-contact-button {
  width: calc((100% - 64rpx) / 2);
  height: 82rpx;
  margin: 0 0 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c8c0b8;
  border-radius: 18rpx;
  color: #1f1b18;
  background: rgba(255, 255, 255, 0.9);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 82rpx;
  box-sizing: border-box;
}

.save-button.disabled,
.delete-contact-button.disabled,
.dialog-button.disabled {
  opacity: 0.55;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 36, 28, 0.28);
  z-index: 100;
}

.delete-dialog {
  width: 600rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fffdf9;
  box-shadow: 0 18rpx 42rpx rgba(44, 36, 28, 0.2);
}

.dialog-title {
  padding: 38rpx 42rpx 16rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.dialog-text {
  padding: 0 46rpx 36rpx;
  color: #6f6861;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.dialog-actions {
  display: flex;
  border-top: 1rpx solid #eadfce;
}

.dialog-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
}

.dialog-button + .dialog-button {
  border-left: 1rpx solid #eadfce;
}

.dialog-button.cancel {
  color: #6f6861;
}

.dialog-button.confirm {
  color: #c52e2b;
}
